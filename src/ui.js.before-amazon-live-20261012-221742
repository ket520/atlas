    if (action === 'clear-all') {
      fadeClearFilter(actionButton);
      fs = '';
      fmethod = '';
      fclassification = '';
      fsrc = '';
      fd = '';
      ft = '';
      trackingScope = '';
      history.replaceState({ page: 'Deliveries' }, '', 'deliveries.html');
