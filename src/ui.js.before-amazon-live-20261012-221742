  if (!tab) return null;

  const source = `Courier Issues · ${tab}`;
  const hasIssueRecord = (delivery.carrierIssueEntries || []).some(item =>
    item.source === source);
  if (!hasIssueRecord) {
    return {
      kind: 'missing-row',
      text: 'No matching row in Courier Issues Excel. Check the carrier platform and follow up.',
    };
  }

  if (tab !== 'Van' || String(delivery.providerStatus || '').toLowerCase() !== 'failed') {
    return null;
  }
  const hasRemark = (delivery.followUps || []).some(item =>
    item.status === source && String(item.remark || '').trim());
  const hasRecordedAction = (delivery.carrierIssueEntries || []).some(item =>
    item.source === source && [item.messageStatus, item.scheduledStatus, item.deliveredStatus]
      .some(value => String(value || '').trim()));
  return hasRemark || hasRecordedAction ? null : {
    kind: 'missing-remark',
    text: 'Courier Issues Excel: no follow-up remark recorded.',
  };
}

